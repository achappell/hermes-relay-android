<?xml version="1.0" encoding="utf-8"?>
<!-- ANDROID-REL-03: exclude all app data from cloud backup and from device-to-device
     transfer. Android 12+ consults this file for device transfer even though the
     manifest sets allowBackup="false". The app holds a Keystore-wrapped Home
     credential, paired Profile data and the diagnostics journal; none of it may
     leave the device, and a restored copy could not decrypt the credential anyway
     because Keystore keys are not transferable. Every data domain is listed so a
     future domain cannot be included by omission. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
